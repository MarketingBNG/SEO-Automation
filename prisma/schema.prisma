// Ported 1:1 from the original lib/db.js (SQLite). Table and column names are kept exactly as
// they were (snake_case), and JSON / timestamp columns stay TEXT in the same
// 'YYYY-MM-DD HH:MM:SS' UTC format SQLite's datetime('now') produced, so every existing read,
// JSON.parse and string date comparison behaves identically.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model keywords {
  id         Int      @id @default(autoincrement())
  batch_name String?
  keyword    String
  notes      String?
  status     String   @default("pending")
  error      String?
  // Live progress while a blog is being written (shown in the dashboard header).
  progress_stage   String?
  progress_percent Int?
  created_at String   @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'::text), 'YYYY-MM-DD HH24:MI:SS'::text)"))
  drafts     drafts[]

  @@index([status])
}

model drafts {
  id                  Int            @id @default(autoincrement())
  keyword_id          Int
  title               String?
  meta_description    String?
  content_html        String?
  research_notes      String?
  // READY_FOR_REVIEW | NEEDS_ATTENTION (set by the automated pipeline)
  production_state    String?
  repair_attempts     Int            @default(0)
  validation_issues   String? // JSON array
  word_count          Int?
  // in_progress | pending_review | approved | rejected | published
  status              String         @default("in_progress")
  featured_image_path String?
  wp_post_id          Int?
  wp_post_url         String?
  created_at          String         @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'::text), 'YYYY-MM-DD HH24:MI:SS'::text)"))
  updated_at          String         @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'::text), 'YYYY-MM-DD HH24:MI:SS'::text)"))
  target_wp_post_id   Int?
  validation_warnings String? // JSON
  people_also_ask     String? // JSON
  keyword_plan        String? // JSON
  linkedin_post       String? // ready-to-post LinkedIn text for the blog
  length_target       String? // JSON { min, max, median, basedOn } from the pages ranking now
  keyword             keywords       @relation(fields: [keyword_id], references: [id])
  facts               facts[]
  draft_images        draft_images[]
}

model facts {
  id             Int     @id @default(autoincrement())
  draft_id       Int
  fact_id        String?
  claim          String
  source_name    String?
  source_url     String?
  jurisdiction   String?
  effective_date String?
  applicability  String?
  exceptions     String?
  // verified | needs_verify
  status         String  @default("needs_verify")
  reviewer       String?
  review_date    String?
  created_at     String  @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'::text), 'YYYY-MM-DD HH24:MI:SS'::text)"))
  draft          drafts  @relation(fields: [draft_id], references: [id])

  @@index([draft_id])
}

model settings {
  key   String @id
  value String
}

model training_examples {
  id           Int     @id @default(autoincrement())
  title        String?
  content_html String
  notes        String?
  created_at   String  @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'::text), 'YYYY-MM-DD HH24:MI:SS'::text)"))
}

model activity_log {
  id          Int     @id @default(autoincrement())
  action      String
  entity_type String?
  entity_id   Int?
  details     String?
  actor       String  @default("system")
  actor_email String? // who did it (signed-in person); empty for automatic work
  source      String? // dashboard | assistant | automatic
  created_at  String  @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'::text), 'YYYY-MM-DD HH24:MI:SS'::text)"))

  @@index([actor_email])
}

model research_digests {
  id         Int     @id @default(autoincrement())
  topic      String?
  summary    String
  sources    String? // JSON
  status     String  @default("pending_approval")
  created_at String  @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'::text), 'YYYY-MM-DD HH24:MI:SS'::text)"))
  decided_at String?
}

model client_insights {
  id            Int     @id @default(autoincrement())
  transcript_id String?
  title         String?
  meeting_date  String?
  overview      String?
  action_items  String?
  keywords      String? // JSON
  status        String  @default("pending_review")
  created_at    String  @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'::text), 'YYYY-MM-DD HH24:MI:SS'::text)"))
  decided_at    String?
}

model blog_audits {
  id                      Int     @id @default(autoincrement())
  title                   String?
  source_url              String?
  content_html            String?
  verdict                 String?
  summary                 String?
  issues                  String? // JSON
  suggestions             String? // JSON
  facts                   String? // JSON
  word_count              Int?
  wp_post_id              Int?
  wp_post_url             String?
  rewrite_title           String?
  rewrite_content_html    String?
  rewrite_status          String?
  created_at              String  @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'::text), 'YYYY-MM-DD HH24:MI:SS'::text)"))
  rewrite_meta            String? // JSON
  people_also_ask         String? // JSON
  rewrite_people_also_ask String? // JSON
}

model image_library {
  id           Int            @id @default(autoincrement())
  filename     String?
  // Storage key (Vercel Blob pathname) of the full-size original; was a local file path.
  path         String
  notes        String?
  created_at   String         @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'::text), 'YYYY-MM-DD HH24:MI:SS'::text)"))
  model_path   String?
  mime_type    String?
  width        Int?
  height       Int?
  draft_images draft_images[]
}

model draft_images {
  id          Int           @id @default(autoincrement())
  draft_id    Int
  image_id    Int
  is_featured Int           @default(0)
  created_at  String        @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'::text), 'YYYY-MM-DD HH24:MI:SS'::text)"))
  draft       drafts        @relation(fields: [draft_id], references: [id])
  image       image_library @relation(fields: [image_id], references: [id])
}

model seo_strategies {
  id                        Int     @id @default(autoincrement())
  period                    String?
  summary                   String?
  keyword_priorities        String? // JSON
  content_recommendations   String? // JSON
  technical_recommendations String? // JSON
  competitor_notes          String?
  data_snapshot             String? // JSON
  status                    String  @default("pending_review")
  created_at                String  @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'::text), 'YYYY-MM-DD HH24:MI:SS'::text)"))
  decided_at                String?
  report_json               String? // JSON
  // Strategy v2 (11-section monthly plan). plan_json holds the sections; version goes up on every edit.
  plan_json                 String? // JSON
  version                   Int     @default(1)
  validation                String? // JSON { errors: [], warnings: [] }
  approved_by               String?
  approved_at               String?
  approved_version          Int?
  // Background generation: status 'generating' with live progress, or 'failed' with the error.
  progress_stage            String?
  progress_percent          Int?
  error                     String?
  // The 30 days the strategy covers (YYYY-MM-DD, India time).
  start_date                String?
  end_date                  String?
}

model writing_skills {
  id                    Int     @id @default(autoincrement())
  skill_content         String
  research_summary      String?
  sources               String? // JSON
  own_performance_notes String?
  status                String  @default("active")
  created_at            String  @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'::text), 'YYYY-MM-DD HH24:MI:SS'::text)"))
}

model technical_crawls {
  id                    Int     @id @default(autoincrement())
  filename              String?
  total_urls            Int?
  broken_count          Int?
  missing_title_count   Int?
  duplicate_title_count Int?
  missing_meta_count    Int?
  thin_content_count    Int?
  problem_urls          String? // JSON
  // Screaming Frog upload gate: the stored file, who uploaded it, and link-level findings.
  file_key              String?
  uploaded_by           String?
  links_count           Int?
  link_issues           String? // JSON
  created_at            String  @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'::text), 'YYYY-MM-DD HH24:MI:SS'::text)"))
}

model assistant_conversations {
  id         Int     @id @default(autoincrement())
  title      String?
  messages   String  @default("[]") // JSON, append-only Anthropic history
  pending    String? // JSON
  status     String  @default("idle")
  created_by String?
  created_at String  @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'::text), 'YYYY-MM-DD HH24:MI:SS'::text)"))
  updated_at String  @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'::text), 'YYYY-MM-DD HH24:MI:SS'::text)"))
}

// Every file attached in the assistant chat (Word documents and images), kept so the team can
// open it again later.
model assistant_files {
  id          Int     @id @default(autoincrement())
  kind        String // document | image
  filename    String
  path        String // storage key, served at /api/uploads/<path>
  mime        String
  size        Int
  uploaded_by String?
  created_at  String  @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'::text), 'YYYY-MM-DD HH24:MI:SS'::text)"))
}

model site_changes {
  id              Int     @id @default(autoincrement())
  conversation_id Int?
  tool            String
  summary         String?
  target_type     String?
  target_id       String?
  undo            String? // JSON
  status          String  @default("applied")
  created_at      String  @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'::text), 'YYYY-MM-DD HH24:MI:SS'::text)"))
  undone_at       String?
}

model paa_questions {
  id           Int     @id @default(autoincrement())
  question_key String  @unique
  question     String
  keyword      String?
  markets      String?
  times_seen   Int     @default(1)
  first_seen   String  @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'::text), 'YYYY-MM-DD HH24:MI:SS'::text)"))
  last_seen    String  @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'::text), 'YYYY-MM-DD HH24:MI:SS'::text)"))
}

// New: replaces secrets/zoho-tokens.json and secrets/gbp-tokens.json (Vercel has no writable disk).
// provider = 'zoho' | 'gbp'; data = the exact JSON object that used to be written to the file.
model oauth_tokens {
  provider   String @id
  data       String
  updated_at String @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'::text), 'YYYY-MM-DD HH24:MI:SS'::text)"))
}

// Every edit a reviewer makes to a strategy section (audit log).
model strategy_edits {
  id          Int    @id @default(autoincrement())
  strategy_id Int
  reviewer    String
  section     String
  old_value   String?
  new_value   String?
  version     Int
  created_at  String @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'::text), 'YYYY-MM-DD HH24:MI:SS'::text)"))

  @@index([strategy_id])
}

// Mid-month changes to an approved strategy.
model strategy_changes {
  id          Int    @id @default(autoincrement())
  strategy_id Int
  what        String
  why         String
  approved_by String
  created_at  String @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'::text), 'YYYY-MM-DD HH24:MI:SS'::text)"))

  @@index([strategy_id])
}

// One main keyword per blog, never reused across months.
model strategy_keywords {
  id          Int    @id @default(autoincrement())
  keyword_key String @unique
  keyword     String
  period      String
  strategy_id Int
  created_at  String @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'::text), 'YYYY-MM-DD HH24:MI:SS'::text)"))
}

// Verified Facts Register: tax figures, rates and deadlines that blogs may state.
model verified_facts {
  id          Int     @id @default(autoincrement())
  value       String // the figure as written, e.g. "30%", "April 15", "Rs 7 lakh"
  claim       String  @unique
  source_url  String?
  verified_by String?
  jurisdiction    String?
  times_used      Int     @default(0)
  last_checked_at String?
  created_at  String  @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'::text), 'YYYY-MM-DD HH24:MI:SS'::text)"))
}

// The month's blog calendar after approval; drives the 24-hour review window.
model blog_schedule {
  id               Int     @id @default(autoincrement())
  strategy_id      Int
  publish_at       String // UTC 'YYYY-MM-DD HH:MM:SS'
  title            String
  main_keyword     String
  cluster          String?
  tags             String // JSON array of SEO/AEO/GEO
  refresh_url      String?
  keyword_id       Int?
  draft_id         Int?
  // planned | drafting | in_review | rejected | revising | held | published | failed
  status           String  @default("planned")
  review_started   String?
  reviewed_by      String?
  reviewed_at      String?
  approval_mode    String? // reviewed | auto
  hold_reasons     String? // JSON
  wp_post_url      String?
  post_publish_log String? // JSON
  // Automatic fact check: { stamp (draft updated_at it covers), ok, rounds, log, checkedAt }
  fact_check       String? // JSON
  author           String? // partner the post is published under
  reject_feedback  String? // what the reviewer asked to change
  rejected_by      String?
  revision_note    String? // JSON [{ asked, changed }] shown to the reviewer after a rewrite
  revisions        Int     @default(0)
  expert_reviewer  String? // the CA/CPA who approved it (tax, legal and compliance topics)
  reminded_at      String? // last overdue-review reminder
  cta              String? // JSON { service, text, url } chosen for this blog
  created_at       String  @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'::text), 'YYYY-MM-DD HH24:MI:SS'::text)"))
  updated_at       String  @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'::text), 'YYYY-MM-DD HH24:MI:SS'::text)"))

  @@index([status])
}

model backlink_tasks {
  id          Int    @id @default(autoincrement())
  strategy_id Int
  target_site String
  method      String
  our_page    String
  send_date   String
  tags        String // JSON
  status      String @default("planned")
  // Automatic outreach: who was emailed, what was sent, and when the link was found.
  contact_email String?
  email_subject String?
  email_body    String?
  sent_at       String?
  followup_at   String?
  verified_at   String?
  note          String?
  guide         String? // JSON: step-by-step guide for a person, written on demand
  assigned_to   String? // email of the person who should do it (manual tasks)
  created_at  String @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'::text), 'YYYY-MM-DD HH24:MI:SS'::text)"))
}

// Technical fixes ticked in the approved strategy, applied automatically through WordPress.
model technical_fix_tasks {
  id          Int     @id @default(autoincrement())
  strategy_id Int
  url         String
  issue       String
  fix         String
  kind        String
  status      String  @default("planned") // planned, applied, manual, failed
  result      String?
  applied_at  String?
  guide       String? // JSON: step-by-step guide for a person, written on demand
  assigned_to String? // email of the person who should do it (manual tasks)
  created_at  String  @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'::text), 'YYYY-MM-DD HH24:MI:SS'::text)"))

  @@index([strategy_id])
}

// Daily rank snapshot per priority keyword, used for the 5+ position drop alert.
model rank_snapshots {
  id         Int     @id @default(autoincrement())
  keyword    String
  position   Int?
  checked_on String // YYYY-MM-DD
  created_at String  @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'::text), 'YYYY-MM-DD HH24:MI:SS'::text)"))

  @@unique([keyword, checked_on])
}

// Weekly plan vs actual check results.
model plan_checks {
  id          Int    @id @default(autoincrement())
  strategy_id Int
  week_of     String
  result      String // JSON
  created_at  String @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'::text), 'YYYY-MM-DD HH24:MI:SS'::text)"))
}

// Cost of every Claude call, from the token usage the API returns (see lib/aiCredits.ts).
model ai_usage {
  id                 Int    @id @default(autoincrement())
  feature            String // strategy | blog | fact-check | reports | meetings | assistant | other
  model              String
  input_tokens       Int    @default(0)
  output_tokens      Int    @default(0)
  cache_read_tokens  Int    @default(0)
  cache_write_tokens Int    @default(0)
  web_searches       Int    @default(0)
  cost_usd           Float  @default(0)
  created_at         String @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'::text), 'YYYY-MM-DD HH24:MI:SS'::text)"))

  @@index([created_at])
}

// People who can sign in, their role (admin, manager, analyst, user) and whether they are blocked.
// Anyone with a company Google account is added as "user" on first sign-in.
model team_members {
  id         Int     @id @default(autoincrement())
  email      String  @unique
  name       String?
  role       String  @default("user")
  role_expires_at String? // the tester role ends at this UTC time and the person becomes a user again
  blocked    Boolean @default(false)
  updated_by String?
  created_at String  @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'::text), 'YYYY-MM-DD HH24:MI:SS'::text)"))
  updated_at String  @default(dbgenerated("to_char((now() AT TIME ZONE 'utc'::text), 'YYYY-MM-DD HH24:MI:SS'::text)"))
}
