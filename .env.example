# Copy to .env (local) and add the same variables in Vercel > Project > Settings > Environment Variables.

# --- Database (Neon Postgres) ---------------------------------------------------------------
# Pooled connection string from the Neon dashboard (or set automatically by the Vercel Neon integration).
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# --- Sign-in (NextAuth + Google, @usaindiacfo.com only) --------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
NEXTAUTH_SECRET=
# Local: http://localhost:3000 ; production: https://<your-vercel-domain>
NEXTAUTH_URL=http://localhost:3000
# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web).
# Authorised redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional; defaults to usaindiacfo.com
ALLOWED_EMAIL_DOMAIN=usaindiacfo.com

# --- Vercel Cron -----------------------------------------------------------------------------
# Any long random string. Vercel sends it as "Authorization: Bearer <CRON_SECRET>" on cron calls.
CRON_SECRET=

# --- File storage (Vercel Blob, private store) -----------------------------------------------
BLOB_READ_WRITE_TOKEN=

# --- Anthropic -------------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Optional overrides (default: claude-opus-5-5)
ANTHROPIC_MODEL=
ASSISTANT_MODEL=

# --- WordPress (application password) --------------------------------------------------------
WORDPRESS_SITE_URL=https://usaindiacfo.com
WORDPRESS_USERNAME=
WORDPRESS_APPLICATION_PASSWORD=

# --- Google Search Console / GA4 (service account) -------------------------------------------
# On Vercel paste the whole service-account JSON on one line. Locally you may instead set
# GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./secrets/google-service-account.json
GOOGLE_SERVICE_ACCOUNT_KEY_JSON=
GSC_SITE_URL=
GA4_PROPERTY_ID=

# --- Google Business Profile (OAuth) ---------------------------------------------------------
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
# <NEXTAUTH_URL>/api/gbp/oauth-callback
GBP_REDIRECT_URI=

# --- Zoho CRM (OAuth, India data centre) -----------------------------------------------------
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_BASE_URL=https://www.zohoapis.in
# <NEXTAUTH_URL>/api/zoho/oauth-callback
ZOHO_REDIRECT_URI=

# --- SEO / analytics tools -------------------------------------------------------------------
PAGESPEED_API_KEY=
CLARITY_API_TOKEN=
SERANKING_API_KEY=
SERPHOUSE_API_KEY=
SURFER_API_KEY=
SURFER_WORKSPACE_ID=
FIREFLIES_API_KEY=
